digraph ER {
	graph [bgcolor=white fontname="DejaVu Sans" fontsize=19 label="ER - Логическая модель данных образовательной платформы" labelloc=t nodesep=.38 pad=.35 rankdir=LR ranksep=1.0 splines=spline]
	node [fontname="DejaVu Sans" shape=plain]
	edge [arrowhead=none color="#69849d" fontname="DejaVu Sans" fontsize=10 penwidth=1.3]
	USER [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#557898"><TR><TD BGCOLOR="#dfecf8" ALIGN="CENTER"><FONT FACE="DejaVu Sans" POINT-SIZE="12"><B>USER</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">user_id UUID PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">email TEXT UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">password_hash TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">role ENUM</FONT></TD></TR></TABLE>>]
	COURSE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#557898"><TR><TD BGCOLOR="#dfecf8" ALIGN="CENTER"><FONT FACE="DejaVu Sans" POINT-SIZE="12"><B>COURSE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">course_id UUID PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">author_id UUID FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">title TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">status ENUM</FONT></TD></TR></TABLE>>]
	ENROLLMENT [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#557898"><TR><TD BGCOLOR="#dfecf8" ALIGN="CENTER"><FONT FACE="DejaVu Sans" POINT-SIZE="12"><B>ENROLLMENT</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">user_id UUID PK,FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">course_id UUID PK,FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">enrolled_at TIMESTAMP</FONT></TD></TR></TABLE>>]
	TOPIC [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#557898"><TR><TD BGCOLOR="#dfecf8" ALIGN="CENTER"><FONT FACE="DejaVu Sans" POINT-SIZE="12"><B>TOPIC</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">topic_id UUID PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">course_id UUID FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">title TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">position INTEGER</FONT></TD></TR></TABLE>>]
	TOPIC_PREREQUISITE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#557898"><TR><TD BGCOLOR="#dfecf8" ALIGN="CENTER"><FONT FACE="DejaVu Sans" POINT-SIZE="12"><B>TOPIC_PREREQUISITE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">topic_id UUID PK,FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">prerequisite_topic_id UUID PK,FK</FONT></TD></TR></TABLE>>]
	MATERIAL [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#557898"><TR><TD BGCOLOR="#dfecf8" ALIGN="CENTER"><FONT FACE="DejaVu Sans" POINT-SIZE="12"><B>MATERIAL</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">material_id UUID PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">topic_id UUID FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">title TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">type ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">body TEXT</FONT></TD></TR></TABLE>>]
	TASK [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#557898"><TR><TD BGCOLOR="#dfecf8" ALIGN="CENTER"><FONT FACE="DejaVu Sans" POINT-SIZE="12"><B>TASK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">task_id UUID PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">topic_id UUID FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">task_type ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">difficulty INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">answer_key TEXT</FONT></TD></TR></TABLE>>]
	ATTEMPT [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#557898"><TR><TD BGCOLOR="#dfecf8" ALIGN="CENTER"><FONT FACE="DejaVu Sans" POINT-SIZE="12"><B>ATTEMPT</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">attempt_id UUID PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">user_id UUID FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">task_id UUID FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">submitted_answer TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">is_correct BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">submitted_at TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">attempt_number INTEGER</FONT></TD></TR></TABLE>>]
	ACTIVITY_EVENT [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#557898"><TR><TD BGCOLOR="#dfecf8" ALIGN="CENTER"><FONT FACE="DejaVu Sans" POINT-SIZE="12"><B>ACTIVITY_EVENT</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">event_id UUID PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">user_id UUID FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">material_id UUID NULL FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">task_id UUID NULL FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">event_type TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">occurred_at TIMESTAMP</FONT></TD></TR></TABLE>>]
	TOPIC_MASTERY [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#557898"><TR><TD BGCOLOR="#dfecf8" ALIGN="CENTER"><FONT FACE="DejaVu Sans" POINT-SIZE="12"><B>TOPIC_MASTERY</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">user_id UUID PK,FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">topic_id UUID PK,FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">mastery_score REAL</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">updated_at TIMESTAMP</FONT></TD></TR></TABLE>>]
	MODEL_VERSION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#557898"><TR><TD BGCOLOR="#dfecf8" ALIGN="CENTER"><FONT FACE="DejaVu Sans" POINT-SIZE="12"><B>MODEL_VERSION</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">model_id UUID PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">version TEXT UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">artifact_hash TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">created_at TIMESTAMP</FONT></TD></TR></TABLE>>]
	EXPERIMENT_RUN [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#557898"><TR><TD BGCOLOR="#dfecf8" ALIGN="CENTER"><FONT FACE="DejaVu Sans" POINT-SIZE="12"><B>EXPERIMENT_RUN</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">run_id UUID PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">model_id UUID FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">dataset_version TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">parameters_json JSON</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">metrics_json JSON</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="DejaVu Sans" POINT-SIZE="11">executed_at TIMESTAMP</FONT></TD></TR></TABLE>>]
	USER -> COURSE [label="1 : N автор" constraint=true weight=2]
	USER -> ENROLLMENT [label="1 : N" constraint=true weight=2]
	COURSE -> ENROLLMENT [label="1 : N" constraint=true weight=2]
	COURSE -> TOPIC [label="1 : N" constraint=true weight=2]
	TOPIC -> MATERIAL [label="1 : N" constraint=true weight=2]
	TOPIC -> TASK [label="1 : N" constraint=true weight=2]
	TOPIC -> TOPIC_PREREQUISITE [label="1 : N зависимая" constraint=false weight=1]
	TOPIC -> TOPIC_PREREQUISITE [label="1 : N требуется" constraint=false weight=1]
	USER -> ATTEMPT [label="1 : N" constraint=false weight=1]
	TASK -> ATTEMPT [label="1 : N" constraint=false weight=1]
	USER -> ACTIVITY_EVENT [label="1 : N" constraint=false weight=1]
	MATERIAL -> ACTIVITY_EVENT [label="0..1 : N" constraint=false weight=1]
	TASK -> ACTIVITY_EVENT [label="0..1 : N" constraint=false weight=1]
	USER -> TOPIC_MASTERY [label="1 : N" constraint=false weight=1]
	TOPIC -> TOPIC_MASTERY [label="1 : N" constraint=false weight=1]
	MODEL_VERSION -> EXPERIMENT_RUN [label="1 : N" constraint=false weight=1]
}
