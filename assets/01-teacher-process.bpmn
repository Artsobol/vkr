<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_02_teacher_process" targetNamespace="https://example.org/lab3/bpmn">
  <process id="Process_02_teacher_process" name="BPMN 2.0 - Работа преподавателя" isExecutable="false">
    <laneSet id="LaneSet_02_teacher_process">
      <lane id="Lane_learner" name="Преподаватель">
        <flowNodeRef>Node_start</flowNodeRef>
        <flowNodeRef>Node_login</flowNodeRef>
        <flowNodeRef>Node_manage</flowNodeRef>
        <flowNodeRef>Node_show</flowNodeRef>
        <flowNodeRef>Node_done2</flowNodeRef>
      </lane>
      <lane id="Lane_platform" name="Образовательная платформа">
        <flowNodeRef>Node_auth</flowNodeRef>
        <flowNodeRef>Node_allowed</flowNodeRef>
        <flowNodeRef>Node_deny</flowNodeRef>
        <flowNodeRef>Node_denied</flowNodeRef>
        <flowNodeRef>Node_action</flowNodeRef>
        <flowNodeRef>Node_validate</flowNodeRef>
        <flowNodeRef>Node_commit</flowNodeRef>
        <flowNodeRef>Node_done</flowNodeRef>
        <flowNodeRef>Node_results</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Node_start" name="Начало">
      <outgoing>Flow_0</outgoing>
    </startEvent>
    <userTask id="Node_login" name="Войти в аккаунт">
      <incoming>Flow_0</incoming>
      <outgoing>Flow_1</outgoing>
    </userTask>
    <serviceTask id="Node_auth" name="Проверить аккаунт и роль">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </serviceTask>
    <exclusiveGateway id="Node_allowed" name="Доступ разрешён?">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <outgoing>Flow_5</outgoing>
    </exclusiveGateway>
    <serviceTask id="Node_deny" name="Отказать в доступе">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
    </serviceTask>
    <endEvent id="Node_denied" name="Отказ">
      <incoming>Flow_4</incoming>
    </endEvent>
    <exclusiveGateway id="Node_action" name="Выбор операции">
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
      <outgoing>Flow_10</outgoing>
    </exclusiveGateway>
    <userTask id="Node_manage" name="Создать / изменить / удалить курс, материалы, задания">
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
    </userTask>
    <serviceTask id="Node_validate" name="Проверить владение, данные и зависимости">
      <incoming>Flow_7</incoming>
      <outgoing>Flow_8</outgoing>
    </serviceTask>
    <serviceTask id="Node_commit" name="Сохранить изменения / удалить безопасно">
      <incoming>Flow_8</incoming>
      <outgoing>Flow_9</outgoing>
    </serviceTask>
    <endEvent id="Node_done" name="Конец">
      <incoming>Flow_9</incoming>
    </endEvent>
    <serviceTask id="Node_results" name="Проверить право на курс и получить прогресс">
      <incoming>Flow_10</incoming>
      <outgoing>Flow_11</outgoing>
    </serviceTask>
    <userTask id="Node_show" name="Просмотреть результаты">
      <incoming>Flow_11</incoming>
      <outgoing>Flow_12</outgoing>
    </userTask>
    <endEvent id="Node_done2" name="Конец">
      <incoming>Flow_12</incoming>
    </endEvent>
    <sequenceFlow id="Flow_0" sourceRef="Node_start" targetRef="Node_login"/>
    <sequenceFlow id="Flow_1" sourceRef="Node_login" targetRef="Node_auth"/>
    <sequenceFlow id="Flow_2" sourceRef="Node_auth" targetRef="Node_allowed"/>
    <sequenceFlow id="Flow_3" sourceRef="Node_allowed" targetRef="Node_deny" name="Нет"/>
    <sequenceFlow id="Flow_4" sourceRef="Node_deny" targetRef="Node_denied"/>
    <sequenceFlow id="Flow_5" sourceRef="Node_allowed" targetRef="Node_action" name="Да"/>
    <sequenceFlow id="Flow_6" sourceRef="Node_action" targetRef="Node_manage" name="Контент"/>
    <sequenceFlow id="Flow_7" sourceRef="Node_manage" targetRef="Node_validate"/>
    <sequenceFlow id="Flow_8" sourceRef="Node_validate" targetRef="Node_commit"/>
    <sequenceFlow id="Flow_9" sourceRef="Node_commit" targetRef="Node_done"/>
    <sequenceFlow id="Flow_10" sourceRef="Node_action" targetRef="Node_results" name="Прогресс"/>
    <sequenceFlow id="Flow_11" sourceRef="Node_results" targetRef="Node_show"/>
    <sequenceFlow id="Flow_12" sourceRef="Node_show" targetRef="Node_done2"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_02-teacher-process">
    <bpmndi:BPMNPlane id="Plane_02-teacher-process" bpmnElement="Process_02_teacher_process">
      <bpmndi:BPMNShape id="Shape_Lane_learner" bpmnElement="Lane_learner" isHorizontal="true">
        <dc:Bounds x="24" y="75" width="2152" height="115"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_platform" bpmnElement="Lane_platform" isHorizontal="true">
        <dc:Bounds x="24" y="190" width="2152" height="540"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_start" bpmnElement="Node_start">
        <dc:Bounds x="105" y="113" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_login" bpmnElement="Node_login">
        <dc:Bounds x="195" y="100" width="175" height="62"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_auth" bpmnElement="Node_auth">
        <dc:Bounds x="435" y="265" width="200" height="66"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_allowed" bpmnElement="Node_allowed">
        <dc:Bounds x="680" y="269" width="62" height="62"/>
