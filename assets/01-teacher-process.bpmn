        <di:waypoint x="1250" y="129"/>
        <di:waypoint x="1250" y="298"/>
        <di:waypoint x="1280" y="298"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_8" bpmnElement="Flow_8">
        <di:waypoint x="1535" y="298.0"/>
        <di:waypoint x="1575" y="298.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_9" bpmnElement="Flow_9">
        <di:waypoint x="1825" y="298.0"/>
        <di:waypoint x="1890" y="298.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_10" bpmnElement="Flow_10">
        <di:waypoint x="841" y="331"/>
