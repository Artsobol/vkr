      <bpmndi:BPMNShape id="Shape_deny" bpmnElement="Node_deny">
        <dc:Bounds x="800" y="590" width="165" height="66"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_denied" bpmnElement="Node_denied">
        <dc:Bounds x="1012" y="603" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_action" bpmnElement="Node_action">
        <dc:Bounds x="810" y="269" width="62" height="62"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_manage" bpmnElement="Node_manage">
        <dc:Bounds x="935" y="94" width="300" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_validate" bpmnElement="Node_validate">
        <dc:Bounds x="1280" y="265" width="255" height="66"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_commit" bpmnElement="Node_commit">
        <dc:Bounds x="1575" y="265" width="250" height="66"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_done" bpmnElement="Node_done">
        <dc:Bounds x="1890" y="280" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_results" bpmnElement="Node_results">
        <dc:Bounds x="1080" y="445" width="265" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_show" bpmnElement="Node_show">
        <dc:Bounds x="1440" y="94" width="230" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_done2" bpmnElement="Node_done2">
        <dc:Bounds x="1750" y="111" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_0" bpmnElement="Flow_0">
        <di:waypoint x="141" y="131.0"/>
        <di:waypoint x="195" y="131.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_1" bpmnElement="Flow_1">
        <di:waypoint x="370" y="131"/>
        <di:waypoint x="400" y="131"/>
        <di:waypoint x="400" y="298"/>
        <di:waypoint x="435" y="298"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_2" bpmnElement="Flow_2">
        <di:waypoint x="635" y="298.0"/>
        <di:waypoint x="680" y="300.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_3" bpmnElement="Flow_3">
        <di:waypoint x="711" y="331"/>
        <di:waypoint x="711" y="623"/>
        <di:waypoint x="800" y="623"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_4" bpmnElement="Flow_4">
        <di:waypoint x="965" y="623.0"/>
        <di:waypoint x="1012" y="621.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_5" bpmnElement="Flow_5">
        <di:waypoint x="742" y="300.0"/>
        <di:waypoint x="810" y="300.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_6" bpmnElement="Flow_6">
        <di:waypoint x="841" y="269"/>
        <di:waypoint x="841" y="131"/>
